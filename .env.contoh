# Salin ke .env lalu isi dengan kredensial Aswaya Anda sendiri.
# Berkas .env tidak pernah ikut ter-commit (lihat .gitignore).
#
# Cukup isi salah satu: ASWAYA_PASSWORD, atau ASWAYA_TOKEN. Kalau keduanya
# terisi, ASWAYA_TOKEN dipakai lebih dulu dan password hanya dipakai untuk
# login ulang saat token itu ditolak. Isian kosong dianggap belum diisi.
#
# Password dan token sengaja dibiarkan kosong di contoh ini. Nilai karangan
# yang lupa diganti akan terkirim sebagai percobaan login yang gagal, dan
# Moodle bisa mengunci akun setelah beberapa kali gagal.

ASWAYA_URL=https://aswaya.pradita.ac.id
ASWAYA_USERNAME=nama.anda@pradita.ac.id
ASWAYA_PASSWORD=
# Token web service layanan moodle_mobile_app: 32 karakter heksadesimal,
# bentuknya seperti 0123456789abcdef0123456789abcdef (bukan token sungguhan).
ASWAYA_TOKEN=
